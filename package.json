{
  "name": "kelu-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "可噜记账 - 一款简洁温暖的离线桌面记账应用",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-vite": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.kelu.ledger",
    "productName": "可噜记账",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "可噜记账"
    }
  },
  "allowScripts": {
    "electron@43.4.0": true
  }
}
